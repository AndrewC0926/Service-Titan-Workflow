# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_engine

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-...

# GitHub connector
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org-name
MAX_REPOS=100

# Okta connector
OKTA_DOMAIN=yourcompany.okta.com
OKTA_TOKEN=00...

# AWS connector
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Jira connector
JIRA_HOST=yourcompany.atlassian.net
JIRA_EMAIL=compliance@yourcompany.com
JIRA_API_TOKEN=...

# Stripe connector
STRIPE_SECRET_KEY=sk_live_...

# Anecdotes GRC
ANECDOTES_API_KEY=...
ANECDOTES_BASE_URL=https://api.anecdotes.ai

# Slack alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL_SECURITY=#security-alerts
SLACK_CHANNEL_COMPLIANCE=#compliance

# Auth (trust center)
AUTH0_DOMAIN=yourcompany.auth0.com
AUTH0_CLIENT_ID=...
AUTH0_CLIENT_SECRET=...

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
