{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/scout *)",
      "Bash(.venv/bin/python *)",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(ps *)",
      "Bash(*.venv/bin/python*)",
      "Bash(*.venv/bin/pytest*)",
      "Bash(*python -m app.cli*)",
      "Bash(.venv/bin/python -c *)"
    ],
    "deny": [
      "Bash(*purge-source*)",
      "Bash(*--reset*)",
      "Bash(*--force*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DELETE FROM*)"
    ]
  }
}
